rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTable(data) {
      return data.id is number && data.id >= 1 && data.id <= 53 &&
             data.isOccupied is bool &&
             (!('chairs' in data) || (data.chairs is number && data.chairs >= 1 && data.chairs <= 20)) &&
             (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
             (!('occupiedAt' in data) || data.occupiedAt == null || data.occupiedAt is number) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    function isValidWaitlistItem(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.places is number && data.places >= 1 && data.places <= 50 &&
             data.completed is bool &&
             data.order is number &&
             (!('completedAt' in data) || data.completedAt == null || data.completedAt is number) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    match /tables/{tableId} {
      allow read: if true;
      allow create, update: if isValidId(tableId) && isValidTable(request.resource.data);
      allow delete: if false;
    }

    match /waitlist/{itemId} {
      allow read: if true;
      allow create, update: if isValidId(itemId) && isValidWaitlistItem(request.resource.data);
      allow delete: if isValidId(itemId);
    }
  }
}
